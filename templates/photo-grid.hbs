<div class="photo-grid">
    {{#each posts}}
        {{#each this.images}}
            <a class="photo" href="{{../url}}" target="_blank" rel="noopener noreferrer">
                <img src="./assets/images/{{../../postsRoot}}{{this}}" alt="{{../caption}}" />
                {{!-- <p class="caption">{{../caption}}</p> --}}
            </a>
        {{/each}}
    {{/each}}
</div> 
