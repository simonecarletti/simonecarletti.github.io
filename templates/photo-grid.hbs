<div class="container photo-grid">
    {{#each instagramPosts }}
        {{#each this.images}}
            <a class="photo" href="{{../url}}" target="_blank" rel="noopener noreferrer">
                <img src="./assets/images/{{this}}" alt="{{../caption}}" />
                {{!-- <p class="caption">{{../caption}}</p> --}}
            </a>
        {{/each}}
    {{/each}}
</div> 
